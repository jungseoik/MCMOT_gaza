# MACS-EVAC 환경변수 예시 — 실제 값으로 채워서 .env 로 복사하거나 export 로 지정
# 모든 항목은 선택(기본값 있음)이므로 바꿔야 할 것만 설정하면 됩니다.

# ── 멀티카메라 시스템 (system/) ───────────────────────────────────────────────
# 사이트 식별자 (data/sites/<SITE_ID>/ 에 설정 영속화)
SITE_ID=default

# 사이트 데이터 루트 (기본: 레포 루트의 data/sites)
# SITE_ROOT=/absolute/path/to/data/sites

# 인제스트 백엔드: ffmpeg(기본, 카메라별 서브프로세스) | deepstream(GPU 상주 배치)
# INGEST_BACKEND=ffmpeg

# 디코딩/추론 GPU 분산 (콤마 구분).
#   ffmpeg 모드 기본 0,1  /  deepstream 모드 기본 1
GPU_DEVICES=0,1

# 추론 모델 조합(검출기+ReID) 기본값 — model_zoo.py 의 프로파일 id.
#   yolox_fastreid(기본, 기존 동작) | yolo26_clipreid(YOLO26-L + CLIP-ReID)
# UI(① 맵 설정 → [추론 모델])에서 고른 값이 data/infer_profile.json 에 남고 이쪽보다 우선한다.
# 엔진 준비: tools/fetch_assets.sh --onnx && tools/build_profile_engines.sh [--ds]
# INFER_PROFILE=yolox_fastreid

# 세션 녹화·리플레이·지표 재계산 (계약 v1.10). 기본 on — 경보 세션의 입력 트랙을
# data/sites/<SITE_ID>/sessions/*.db 로 녹화해 ④ 리플레이 탭에서 재생·재계산.
# 끄려면 0 (기존과 동일 동작·롤백).
# SESSION_RECORD=1

# ── DeepStream 인제스트 (INGEST_BACKEND=deepstream 일 때만) ───────────────────
# GPU당 워커 프로세스 수 (기본 1 권장 — 분할 이득은 과부하 영역에서만)
# WORKERS_PER_GPU=1
# 검출 엔진 직접 지정 / 배치 상한 (미지정 시 INFER_PROFILE 프로파일의 엔진을 쓴다)
# DS_DET_ENGINE=external/weights/trt_ds/yolox_mot20_fp16_dyn_b16.engine
# DS_ENGINE_MAX_BATCH=16

# ── 단일채널 웹 UI (webui/) ───────────────────────────────────────────────────
# Depth 자동 모드용 da3 conda env 파이썬 경로 (기본: ~/miniconda3/envs/da3/bin/python)
# DA3_PYTHON=/home/user/miniconda3/envs/da3/bin/python

# ── Hugging Face 인증 (모델 최초 다운로드 시 필요) ───────────────────────────
# huggingface-cli login  (토큰은 ~/.cache/huggingface/token 에 저장됨)
# 또는:
# HUGGING_FACE_HUB_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
